# ==============================================================================
# CertiFlow Environment Configuration (.env.example)
# Copy this file to .env before starting the services
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=certiflow
DATABASE_URL=postgres://postgres:postgres@localhost:5432/certiflow

# Redis (Rate Limiting, Verification Cache & Pub/Sub for SSE)
REDIS_URL=redis://localhost:6379

# Mock WhatsApp Service
MOCK_WHATSAPP_PORT=4001
MOCK_WHATSAPP_URL=http://localhost:4001

# Backend API
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
API_URL=http://localhost:4000

# Frontend (Next.js)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-certiflow-2026
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# SLA Escalation Demo Limits (shrinks 24h / 48h limits to seconds for quick testing)
ESCALATION_REMINDER_SECONDS=15
ESCALATION_STATE_SECONDS=30
SLA_DEMO_FAST_MODE=true
